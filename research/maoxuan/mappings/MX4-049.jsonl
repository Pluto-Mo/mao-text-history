{"work_id": "MX4-049", "matched_key": "评战犯求和", "normalized_offset": 391, "normalized_context": "央军委起草致林彪电请令刘亚楼研究在攻击天津时是否有办法使工业区避免破坏或减少破坏的程度同日就蒋介石的新年文告2新华社发表毛泽东写的揭露战犯蒋介石求和阴谋的评论指出蒋介石求和是为了保存中国反动势力和美国在华侵略势力这个评论编入毛泽东选集时题为评战犯求和1月6日为中共中央军委起草致林彪谭政电指出3841949年1月12一九四九年元旦蒋介石在新年文告中声称要在保存中华民国的宪法法统和军队等条件下愿与共产党商谈停止战事恢复和平的具体方法崔先生指崔载之当时任北平平明日报社社长兼总编辑", "cue_words": ["发表", "编入"], "title_form_signal": "book_title_marks", "witness_id": "A-53fc15cb527a2de9836d", "source_url": "https://raw.githubusercontent.com/M0rtzz/Selected-Works-of-MaoTseTung/4cc981c232e1ffe8fe2974e125c00af8376829ca/%E6%AF%9B%E6%B3%BD%E4%B8%9C%E5%B9%B4%E8%B0%B1/1993%E5%B9%B4%E7%89%88/%E6%AF%9B%E6%B3%BD%E4%B8%9C%E5%B9%B4%E8%B0%B1_%E4%B8%8B%E5%8D%B7.pdf", "raw_sha256": "50a17f3c134e606a557230cee670a6581596154dc9d6da1bb01c5ecb8a819548", "edition_refs": [{"edition_id": "nianpu-pre1949-3", "volume": 3, "basis": "mirror_folder_and_filename_pending_book_imprint_check"}], "kind": "pdf_page", "number": 487, "end": 487, "record_path": "archive/records/A-53fc15cb527a2de9836d.json", "text_path": "archive/text/A-53fc15cb527a2de9836d.txt", "source_title": "毛泽东年谱_下卷", "source_media": "pdf", "source_layer": "digital_PDF_copy", "edition_verification_status": "source_bytes_verified_imprint_images_available_for_review", "public_url_rechecked_this_run": false, "family": "nianpu", "id": "C-4f23b903c804bf19", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
