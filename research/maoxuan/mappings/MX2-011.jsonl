{"work_id": "MX2-011", "matched_key": "统一战线中的独立自主问题", "normalized_offset": 3, "normalized_context": "537统一战线中的独立自主问题一九三八年十一月五日帮助和让步应该是积极的不应该是消极的为了长期合作统一战线中的各党派实行互助互让是必需的但应该是积极的不是消极的我们必须巩固和扩大我党我军同时也应赞助友党友军的巩固和扩大人民要求政府满足自己的政治经济要求同时给政府以一切可能的利于抗日的援助工人要求厂主改良待遇同时积极作工以利抗日地主应该减租减息同时农民应该交租交息团结对外这些都是互助的原则和方针是积极的方针不是消极的片面的方针互让也是如此彼此不挖墙脚彼此不在对方党政军内这是毛泽东在中国共", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-3d8f454387e25bfae9a9", "source_url": "https://ebook.dswxyjy.org.cn/dswxbooks/storage/files/20220801/b0d41b3f5e572ea7b1b190ed18dde2c863381/mobile/javascript/search_config.js", "raw_sha256": "9e3cb10b0c5c6713fe98b61e09fe509107e512fc784b057367b6934bccb25015", "edition_refs": [{"edition_id": "maoxuan-official", "volume": 2, "basis": "official_book_landing_and_reader_configuration"}], "kind": "reader_page", "number": 208, "end": 208, "record_path": "archive/records/A-3d8f454387e25bfae9a9.json", "text_path": "archive/text/A-3d8f454387e25bfae9a9.txt", "source_title": "毛泽东选集（第二卷）〔官方阅读器全文文字层〕", "source_media": "official_page_text", "source_layer": "official_reader_text", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-a797d56f30c17441", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
