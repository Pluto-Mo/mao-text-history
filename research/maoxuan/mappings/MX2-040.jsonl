{"work_id": "MX2-040", "matched_key": "关于打退第二次反共高潮的总结", "normalized_offset": 3, "normalized_context": "781关于打退第二次反共高潮的总结一九四一年五月八日这一次的反共高潮正如三月十八日中央的指示所说是已经过去了继之而来的是在国际国内的新环境中继续抗战的局面在这个新环境中所增加的因素是帝国主义战争的扩大国际革命运动的高涨苏日的中立条约1国民党第二次反共高潮的被击退以及由此产生的国民党政治地位的降低和共产党政治地位的提高再加上最近日本准备新的对华大举进攻为了团结全国人民坚持抗日并继续有效地克服大地主大资产阶级的投降危险和反共逆流起见研究和学习我党在英勇地胜利地反对这次反共高潮的斗争中所获得的教", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-3d8f454387e25bfae9a9", "source_url": "https://ebook.dswxyjy.org.cn/dswxbooks/storage/files/20220801/b0d41b3f5e572ea7b1b190ed18dde2c863381/mobile/javascript/search_config.js", "raw_sha256": "9e3cb10b0c5c6713fe98b61e09fe509107e512fc784b057367b6934bccb25015", "edition_refs": [{"edition_id": "maoxuan-official", "volume": 2, "basis": "official_book_landing_and_reader_configuration"}], "kind": "reader_page", "number": 452, "end": 452, "record_path": "archive/records/A-3d8f454387e25bfae9a9.json", "text_path": "archive/text/A-3d8f454387e25bfae9a9.txt", "source_title": "毛泽东选集（第二卷）〔官方阅读器全文文字层〕", "source_media": "official_page_text", "source_layer": "official_reader_text", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-5c84baeb34397b42", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
{"work_id": "MX2-040", "matched_key": "关于打退第二次反共高潮的总结", "normalized_offset": 0, "normalized_context": "关于打退第二次反共高潮的总结783深戒但是斗争必须是有理有利有节的三者缺一就要吃亏四在反对国民党顽固派的斗争中将买办性的大资产阶级和没有或较少买办性的民族资产阶级加以区别将最反动的大地主和开明绅士及一般地主加以区别这是我党争取中间派和实行三三制政权的理论根据这是去年三月以来中央就屡次指出了的这次反共高潮再一次地证实了它的正确性我们在皖南事变前所取佳电8的立场对于事变后我们转入政治的反攻是完全必要的非此即不能争取中间派因为如果不经过反复多次的经验中间派对于我党为什么必须向国民党顽固派进", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-3d8f454387e25bfae9a9", "source_url": "https://ebook.dswxyjy.org.cn/dswxbooks/storage/files/20220801/b0d41b3f5e572ea7b1b190ed18dde2c863381/mobile/javascript/search_config.js", "raw_sha256": "9e3cb10b0c5c6713fe98b61e09fe509107e512fc784b057367b6934bccb25015", "edition_refs": [{"edition_id": "maoxuan-official", "volume": 2, "basis": "official_book_landing_and_reader_configuration"}], "kind": "reader_page", "number": 454, "end": 454, "record_path": "archive/records/A-3d8f454387e25bfae9a9.json", "text_path": "archive/text/A-3d8f454387e25bfae9a9.txt", "source_title": "毛泽东选集（第二卷）〔官方阅读器全文文字层〕", "source_media": "official_page_text", "source_layer": "official_reader_text", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-87b4818cb701e799", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
