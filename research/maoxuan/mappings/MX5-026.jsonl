{"work_id": "MX5-026", "matched_key": "解决五多问题", "normalized_offset": 0, "normalized_context": "解决五多问题一九五三年三月十九日中文马克思主义文库毛泽东解决五多问题一九五三年三月十九日这是毛泽东同志为中共中央起草的党内指示一我们党政组织在农村工作中存在一些严重地脱离农民群众损害农民及其积极分子的利益的问题即所谓五多问题五多就是任务多会议集训多公文报告表册多组织多积极分子兼职多这些问题很久就存在了中央曾对其中有些问题有过指示要求各级党委予以重视和解决但是不但没有解决反而越来越严重其原因是没有将整个问题系统地提出来尤其重要的是没有在中央大区省市专区和县这五级党政领导", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-484f4d4a9dff92129dfd", "source_url": "https://www.marxists.org/chinese/maozedong/marxist.org-chinese-mao-19530319.htm", "raw_sha256": "c4afe9945dd5016b6b891b7001e3095874004aecd6a01c91ebbc393882fe4825", "edition_refs": [{"edition_id": "maoxuan-mia-catalogue", "volume": 5, "basis": "source_catalogue_not_print_collation"}], "kind": "web_lines", "number": 1, "end": 13, "record_path": "archive/records/A-484f4d4a9dff92129dfd.json", "text_path": "archive/text/A-484f4d4a9dff92129dfd.txt", "source_title": "解决“五多”问题", "source_media": "html", "source_layer": "web_transcription", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-c24a3e4cc47caa6e", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
