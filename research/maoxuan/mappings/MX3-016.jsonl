{"work_id": "MX3-016", "matched_key": "评国民党十一中全会和三届二次国民参政会", "normalized_offset": 457, "normalized_context": "参政会内占大多数的国民党员接受何应钦污蔑八路军的军事报告通过反共决议案把一个表示团结抗日的国民参政会变成了制造反共舆论准备国内战争的国民党御用机关以至共产党参政员董必武同志不得不声明退席以示抗议总此三次反共高潮都是国民党有计划有准备地发动的评国民党十一中全会和三届二次国民参政会一九四三年十月五日毛泽东选集第版第卷第页六中全会来了一个纠正许多同志了解了这个问题六中全会以后还有人觉得国民党很好很漂亮后来出了一个限制异党活动办法又出了一个第一次反共高潮出了这两件事情以后国民党跳加官戴的一副假面具脱掉了他那个不好看的样子就露出来了这时我们一些同志就逐渐觉悟了副编对若干历史事件人物及文献著作的评述", "cue_words": [], "title_form_signal": "plain_phrase_only", "witness_id": "A-f9feca7a3dc91a159ea9", "source_url": "https://www.marxists.org/chinese/pdf/chinese_marxists/mao/01210805.pdf", "raw_sha256": "807b72378e8aa31733c90aec95d73c092feaa08d651d0a1f8f9db3b6948674e0", "edition_refs": [{"edition_id": "mia-other", "volume": null, "basis": "source_catalogue_not_print_collation"}], "kind": "pdf_page", "number": 2225, "end": 2225, "record_path": "archive/records/A-f9feca7a3dc91a159ea9.json", "text_path": "archive/text/A-f9feca7a3dc91a159ea9.txt", "source_title": "毛泽东著作专题摘编", "source_media": "pdf", "source_layer": "digital_PDF_copy", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "other_mia_and_sources", "id": "C-a2c8436dd797d7b3", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
