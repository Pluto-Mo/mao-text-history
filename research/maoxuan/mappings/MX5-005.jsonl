{"work_id": "MX5-005", "matched_key": "征询对待富农策略问题的意见", "normalized_offset": 0, "normalized_context": "征询对待富农策略问题的意见一九五年三月十二日中文马克思主义文库毛泽东征询对待富农策略问题的意见一九五年三月十二日这是毛泽东同志给中共中央中南局并华东局华南分局西南局西北局的通知请就你们现正召开的各省负责同志会议中征询关于对待富农策略问题的意见电告我们即是说在今冬开始的南方几省及西北某些地区的土地改革运动中不但不动资本主义富农而且不动半封建富农待到几年之后再去解决半封建富农问题请你们考虑这样做是否有利些这样做的理由第一是土改规模空前伟大容易发生过左偏向如果我们只动地主不动富农则更能孤", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-32e7544f144152073d6f", "source_url": "https://www.marxists.org/chinese/maozedong/marxist.org-chinese-mao-19500312.htm", "raw_sha256": "446766cee65dffd2ca5c5d22696f00f363bf278522d8401468e0f0e3ad216551", "edition_refs": [{"edition_id": "maoxuan-mia-catalogue", "volume": 5, "basis": "source_catalogue_not_print_collation"}], "kind": "web_lines", "number": 1, "end": 10, "record_path": "archive/records/A-32e7544f144152073d6f.json", "text_path": "archive/text/A-32e7544f144152073d6f.txt", "source_title": "征询对待富农策略问题的意见", "source_media": "html", "source_layer": "web_transcription", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-61a11dfe6164b029", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
{"work_id": "MX5-005", "matched_key": "征询对待富农策略问题的意见", "normalized_offset": 0, "normalized_context": "征询对待富农策略问题的意见一九五〇年三月十二日请就你们现正召开的各省负责同志会议中征询关于对待富农策略问题的意见电告我们即是说在今冬开始的南方几省及西北某些地区的土地改革运动中不但不动资本主义富农而且不动半封建富农待到几年之后再去解决半封建富农问题请你们考虑这样做是否有利些这样做的理由第一是土改规模空前伟大容易发生过左偏向如果我们只动地主不动富农则更能孤立地主保护中农并防止乱打乱杀否则很难防止第二是过去北方土改是在战争中进行的战争空气掩盖了土改空气现在基本上已无战争土改就显得特别突", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-6f3c97f39a890c27616d", "source_url": "https://raw.githubusercontent.com/M0rtzz/Selected-Works-of-MaoTseTung/4cc981c232e1ffe8fe2974e125c00af8376829ca/%E6%AF%9B%E6%B3%BD%E4%B8%9C%E9%80%89%E9%9B%86/%E6%AF%9B%E6%B3%BD%E4%B8%9C%E9%80%89%E9%9B%86.pdf", "raw_sha256": "e65195a022c0a066d8bbcf68fcf452a764f7f759019331cf153dadd16233d242", "edition_refs": [{"edition_id": "maoxuan-mirror-combined-unverified", "volume": null, "basis": "mirror_folder_and_filename_pending_book_imprint_check"}], "kind": "pdf_page", "number": 1224, "end": 1224, "record_path": "archive/records/A-6f3c97f39a890c27616d.json", "text_path": "archive/text/A-6f3c97f39a890c27616d.txt", "source_title": "毛泽东选集", "source_media": "pdf", "source_layer": "digital_PDF_copy", "edition_verification_status": "source_bytes_verified_imprint_images_available_for_review", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-43c48b4d73d1f9a0", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
