{"work_id": "MX3-030", "matched_key": "评赫尔利政策的危险", "normalized_offset": 4, "normalized_context": "1114评赫尔利政策的危险一九四五年七月十二日以美国驻华大使赫尔利1为代表的美国对华政策越来越明显地造成了中国内战的危机坚持反动政策的国民党政府从它在十八年前成立之日起就是以内战为生活的仅在一九三六年西安事变2和一九三七年日本侵入中国本部这样的时机才被迫暂时地放弃全国规模的内战但从一九三九年起局部的内战又在发动并且没有停止过国民党政府在其内部的动员口号是反共第一抗日被放在次要的地位目前国民党政府一切军事布置的重心并不是放在反对日本侵略者方面而是放在向着中国解放区收复失地和消灭中国共", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-30d13185d1f27d6e4de9", "source_url": "https://ebook.dswxyjy.org.cn/dswxbooks/storage/files/20220801/4c7451f802ad6cc211c9bec38ffc1acd46133/mobile/javascript/search_config.js", "raw_sha256": "db32b9fe81193d6391370affabe7b05b930968e84a81546362eba301a8e72fdd", "edition_refs": [{"edition_id": "maoxuan-official", "volume": 3, "basis": "official_book_landing_and_reader_configuration"}], "kind": "reader_page", "number": 335, "end": 335, "record_path": "archive/records/A-30d13185d1f27d6e4de9.json", "text_path": "archive/text/A-30d13185d1f27d6e4de9.txt", "source_title": "毛泽东选集（第三卷）〔官方阅读器全文文字层〕", "source_media": "official_page_text", "source_layer": "official_reader_text", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-723c561606e00dd9", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
