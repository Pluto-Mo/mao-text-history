{"work_id": "MX5-032", "matched_key": "反对党内的资产阶级思想", "normalized_offset": 0, "normalized_context": "反对党内的资产阶级思想一九五三年八月十二日中文马克思主义文库毛泽东反对党内的资产阶级思想一九五三年八月十二日这是毛泽东同志在一九五三年夏季全国财经工作会议上的讲话这次会议开得很好周总理的结论也作得好现在我们可以看出在三反五反运动之后党内有两种性质的错误一种是一般性的错误如五多大家都可能犯什么时候都可能犯五多的错误也可以变成五少的错误另一种是原则性的错误如资本主义倾向这是资产阶级思想在党内的反映是违背马克思列宁主义的立场问题三反五反运动是对党内资产阶级思想的很大打击但是当时仅仅给", "cue_words": [], "title_form_signal": "near_page_heading", "witness_id": "A-06d67332b7dbe1d460af", "source_url": "https://www.marxists.org/chinese/maozedong/marxist.org-chinese-mao-19530812.htm", "raw_sha256": "3622a680b3463331560a1898573bb67304993cf0f315be08a903d0ff5bf642ab", "edition_refs": [{"edition_id": "maoxuan-mia-catalogue", "volume": 5, "basis": "source_catalogue_not_print_collation"}], "kind": "web_lines", "number": 1, "end": 42, "record_path": "archive/records/A-06d67332b7dbe1d460af.json", "text_path": "archive/text/A-06d67332b7dbe1d460af.txt", "source_title": "反对党内的资产阶级思想", "source_media": "html", "source_layer": "web_transcription", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-c1ba62792f54b124", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
