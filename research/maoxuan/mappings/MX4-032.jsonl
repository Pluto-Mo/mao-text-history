{"work_id": "MX4-032", "matched_key": "关于民族资产阶级和开明绅士问题", "normalized_offset": 233, "normalized_context": "建主义官僚资本主义反对人民民主革命的民族资产阶级的少数右翼分子他们也是革命的敌人依附劳动人民反对反动派的民族资产阶级左翼分子以及从封建阶级分裂出来的少数开明绅士他们也是革命者但是这两者都不是敌人或革命者的主体两者都不是可以决定革命性质的力量关于民族资产阶级和开明绅士问题一九四八年三月一日毛泽东选集第版第卷第0页12革命的对象主要是帝国主义封建主义和官僚资本主义在经济落后的半殖民地的中国地主阶级和买办阶级完全是国际资产阶级的附庸其生存和发展是附属于帝国主义的这些阶级代表中国最落后的和最反动的生产关系阻碍中国生产力的发展他们和中国革命的目的完全不相容特别是大地主阶级和大买办阶级他们始终站在帝国主义一边是极端的反革命派其政治代表是国家主义派和国民党右派中国社会各阶级的分析一九二五年十二月一日毛泽东选集第版第0卷第页一切勾结帝国", "cue_words": [], "title_form_signal": "plain_phrase_only", "witness_id": "A-f9feca7a3dc91a159ea9", "source_url": "https://www.marxists.org/chinese/pdf/chinese_marxists/mao/01210805.pdf", "raw_sha256": "807b72378e8aa31733c90aec95d73c092feaa08d651d0a1f8f9db3b6948674e0", "edition_refs": [{"edition_id": "mia-other", "volume": null, "basis": "source_catalogue_not_print_collation"}], "kind": "pdf_page", "number": 464, "end": 464, "record_path": "archive/records/A-f9feca7a3dc91a159ea9.json", "text_path": "archive/text/A-f9feca7a3dc91a159ea9.txt", "source_title": "毛泽东著作专题摘编", "source_media": "pdf", "source_layer": "digital_PDF_copy", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "other_mia_and_sources", "id": "C-b2ee3e0689cb36bd", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
