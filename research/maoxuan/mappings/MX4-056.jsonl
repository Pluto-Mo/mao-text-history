{"work_id": "MX4-056", "matched_key": "国民党反动派由呼吁和平变为呼吁战争", "normalized_offset": 105, "normalized_context": "评战犯求和一九四九年一月四日中文马克思主义文库毛泽东评战犯求和一九四九年一月四日这是毛泽东为新华社写的揭露国民党利用和平谈判来保存反革命实力的一系列评论的第一篇其它的评论是四分五裂的反动派为什么还要空喊全面和平国民党反动派由呼吁和平变为呼吁战争评国民党对战争责任问题的几种答案南京政府向何处去等为了保存中国反动势力和美国在华侵略势力中国第一号战争罪犯国民党匪帮首领蒋介石在今年元旦发表了一篇求和的声明战犯蒋介石宣称只要和议无害于国家的独立完整而有助于人民的休养生息只要神圣的宪法不由我而违反民主宪政不因此而破坏中华民国的国体能够确保中华民国的法统不致中断军队有确实的保障人民能够维持其自由的生活方式与目前最低生活水准则我个人更无复他求只要和平果能实现则个人的进退出处绝不萦怀而一惟国民的公意是从人们不要以", "cue_words": ["发表"], "title_form_signal": "book_title_marks", "witness_id": "A-1409ec085e66523e9c2e", "source_url": "https://www.marxists.org/chinese/maozedong/marxist.org-chinese-mao-19490104.htm", "raw_sha256": "833d3ab0080dc2cfaa290b0728a1fc8b1d9a8e3a03fa8d468bdfd7e48342a434", "edition_refs": [{"edition_id": "maoxuan-mia-catalogue", "volume": 4, "basis": "source_catalogue_not_print_collation"}], "kind": "web_lines", "number": 1, "end": 34, "record_path": "archive/records/A-1409ec085e66523e9c2e.json", "text_path": "archive/text/A-1409ec085e66523e9c2e.txt", "source_title": "评战犯求和", "source_media": "html", "source_layer": "web_transcription", "edition_verification_status": "not_independently_verified", "public_url_rechecked_this_run": false, "family": "maoxuan", "id": "C-dfedbfe3bfa8d2c7", "status": "candidate_only_not_work_identity_revision_or_causation", "normalization": "NFKC plus letters/digits only; context is NOT a verbatim quote"}
